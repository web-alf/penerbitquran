{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Samakan dengan nama Worker di dashboard Cloudflare (Workers & Pages)
  "name": "penerbitquran",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-15",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Aktifkan subdomain workers.dev + URL preview per versi/branch
  "workers_dev": true,
  "preview_urls": true,
  // Binding sesi Astro. ID eksplisit agar build branch (preview) tidak gagal
  // dengan error 10021 "must have a namespace_id specified"
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "a3d5910219db4ccba864a18949359d19"
    }
  ],
  //   "kv_namespaces": [
  //   { "binding": "SESSION", "id": "f51a9e92ce33447381874622de79c213" }
  // ],
  "previews": {
  "kv_namespaces": [
    { "binding": "SESSION", "id": "a3d5910219db4ccba864a18949359d19" }
  ]
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
